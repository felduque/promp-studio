# ========================================
# Prompt Studio — Environment Variables
# ========================================

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=prompt_studio
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# JWT
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-to-another-secure-random-string
JWT_REFRESH_EXPIRATION=7d

# Encryption (for API key vault)
ENCRYPTION_KEY=change-me-32-char-encryption-key!

# API
API_PORT=4000
API_URL=http://localhost:4000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Prompt Studio
